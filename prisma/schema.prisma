// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum RecipeStatus {
  DRAFT
  PUBLISHED
}

model User {
  id                Int       @id @default(autoincrement())
  firstName         String?
  lastName          String?
  username          String?    @unique
  password          String
  email             String    @unique
  familyId Int?
  family            Family?   @relation(fields: [familyId], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())
  passwordChangedAt DateTime  @default(now())
  
  recipes Recipe[]
}

model Recipe {
  id  Int @id @default(autoincrement())
  title String
  servings Int? // might need to change for things like (1-2) or (3 - 4)
  prepTime Int? //  minutes
  cookTime Int? //  minutes

  images RecipeImage[] // one to many for photos

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById Int?
  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  familyId Int?
  family Family? @relation(fields: [familyId], references: [id], onDelete: SetNull)

  status RecipeStatus @default(DRAFT)
}

model RecipeImage {
  id Int @id @default(autoincrement())
  url String
  recipeId  Int
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
}

model Family {
  id Int @id @default(autoincrement())
  name String
  slug String @unique
  code String @unique // join code to send
  createdAt DateTime @default(now())
  initialColor String?
  initialBg String?
  cookbookBg String?
  bio String?

  members User[]
  recipes Recipe[]
}